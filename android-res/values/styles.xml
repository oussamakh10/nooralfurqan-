<?xml version="1.0" encoding="utf-8"?>
<resources>
<style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar"><item name="android:windowBackground">@color/nf_bg</item></style>
<style name="AppTheme.NoActionBar" parent="Theme.AppCompat.NoActionBar">
<item name="windowActionBar">false</item><item name="windowNoTitle">true</item>
<item name="android:background">@color/nf_bg</item><item name="android:windowBackground">@color/nf_bg</item>
<item name="android:statusBarColor">@color/nf_bg</item><item name="android:navigationBarColor">@color/nf_bg</item></style>
<style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
<item name="windowSplashScreenBackground">@color/nf_bg</item>
<item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
<item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item></style>
</resources>